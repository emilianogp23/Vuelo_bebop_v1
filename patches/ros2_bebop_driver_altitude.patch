 }
+
+Ardrone3PilotingStateAltitudeChanged::Ardrone3PilotingStateAltitudeChanged()
+    : altitude(0.0) {}
+
+void Ardrone3PilotingStateAltitudeChanged::set(
+    const ARCONTROLLER_DICTIONARY_ARG_t *arguments) {
+    std::unique_lock<std::mutex> lock(mutex);
+    time = clock_type::now();
+
+    arg = NULL;
+    HASH_FIND_STR(
+	arguments,
+	ARCONTROLLER_DICTIONARY_KEY_ARDRONE3_PILOTINGSTATE_ALTITUDECHANGED_ALTITUDE,
+	arg);
+    if (arg) altitude = arg->value.Double;
+}
+
+std::tuple<time_point, double> Ardrone3PilotingStateAltitudeChanged::get(
+    void) const {
+    std::unique_lock<std::mutex> lock(mutex);
+    return std::make_tuple(time, altitude);
+}
+
+Ardrone3PilotingSettingsStateMaxAltitudeChanged::
+    Ardrone3PilotingSettingsStateMaxAltitudeChanged() {
+    std::get<0>(current_min_max) = 0;
+    std::get<1>(current_min_max) = 0;
+    std::get<2>(current_min_max) = 0;
+}
+
+void Ardrone3PilotingSettingsStateMaxAltitudeChanged::set(
+    const ARCONTROLLER_DICTIONARY_ARG_t *arguments) {
+    std::unique_lock<std::mutex> lock(mutex);
+    received = true;
+
+    arg = NULL;
+    HASH_FIND_STR(
+	arguments,
+	ARCONTROLLER_DICTIONARY_KEY_ARDRONE3_PILOTINGSETTINGSSTATE_MAXALTITUDECHANGED_CURRENT,
+	arg);
+    if (arg) std::get<0>(current_min_max) = arg->value.Float;
+
+    HASH_FIND_STR(
+	arguments,
+	ARCONTROLLER_DICTIONARY_KEY_ARDRONE3_PILOTINGSETTINGSSTATE_MAXALTITUDECHANGED_MIN,
+	arg);
+    if (arg) std::get<1>(current_min_max) = arg->value.Float;
+
+    HASH_FIND_STR(
+	arguments,
+	ARCONTROLLER_DICTIONARY_KEY_ARDRONE3_PILOTINGSETTINGSSTATE_MAXALTITUDECHANGED_MAX,
+	arg);
+    if (arg) std::get<2>(current_min_max) = arg->value.Float;
+}
+
+std::tuple<bool, float, float, float>
+Ardrone3PilotingSettingsStateMaxAltitudeChanged::get(void) const {
+    std::unique_lock<std::mutex> lock(mutex);
+    return std::tuple_cat(std::make_tuple(received), current_min_max);
+}
 }  // namespace bebop_driver
