      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://edificio_01/meshes/building_04.dae</uri>
            <scale>4.0 4.0 4.0</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://edificio_01/meshes/building_04.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>